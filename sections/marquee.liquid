{% style %}
  .section-{{ section.id }} {
    --marquee-background: {{ section.settings.background_color }};
    --marquee-text-color: {{ section.settings.text_color }};
    --marquee-separator-color: {{ section.settings.separator_color }};
  }
{% endstyle %}

{{ 'section-marquee.css' | asset_url | stylesheet_tag }}

<div class="section-{{ section.id }}">
  <div class="marquee-container">
    <div class="marquee-content">
      {%- for i in (1..4) -%}
        {% capture hidden %}{% if i > 1 %}true{% endif %}{% endcapture %}
        {%- for block in section.blocks -%}
          {%- if block.type == 'word' -%}
            {%- if forloop.last and forloop.parentloop.last -%}
              <span class="marquee-word" {{ block.shopify_attributes }} aria-hidden="{{ hidden }}">
                {{- block.settings.text -}}
              </span>
              <span class="marquee-separator" aria-hidden="{{ hidden }}">
                {%- if section.settings.separator_type == 'image' and section.settings.separator_image != blank -%}
                  {{-
                    section.settings.separator_image
                    | image_url: width: section.settings.separator_height
                    | image_tag:
                      height: section.settings.separator_height,
                      width: section.settings.separator_height,
                      loading: 'lazy'
                  -}}
                {%- else -%}
                  {{- section.settings.separator_text -}}
                {%- endif -%}
              </span>
            {%- else -%}
              <span class="marquee-separator" aria-hidden="{{ hidden }}">
                {%- if section.settings.separator_type == 'image' and section.settings.separator_image != blank -%}
                  {{-
                    section.settings.separator_image
                    | image_url: width: section.settings.separator_height
                    | image_tag:
                      height: section.settings.separator_height,
                      width: section.settings.separator_height,
                      loading: 'lazy'
                  -}}
                {%- else -%}
                  {{- section.settings.separator_text -}}
                {%- endif -%}
              </span>
              <span class="marquee-word" {{ block.shopify_attributes }} aria-hidden="{{ hidden }}">
                {{- block.settings.text -}}
              </span>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Marquee",
  "settings": [
    {
      "type": "select",
      "id": "separator_type",
      "label": "Separator Type",
      "options": [
        {
          "value": "text",
          "label": "Text"
        },
        {
          "value": "image",
          "label": "Image"
        }
      ],
      "default": "text"
    },
    {
      "type": "text",
      "id": "separator_text",
      "label": "Text Separator",
      "default": "★",
      "info": "The character or text to use as separator when Text type is selected"
    },
    {
      "type": "image_picker",
      "id": "separator_image",
      "label": "Image Separator",
      "info": "The image to use as separator when Image type is selected"
    },
    {
      "type": "range",
      "id": "separator_height",
      "min": 12,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Separator Size",
      "default": 16,
      "info": "Height of the separator (for both text and image)"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "separator_color",
      "label": "Separator Color",
      "default": "#ffffff",
      "info": "Only applies to text separator"
    }
  ],
  "blocks": [
    {
      "type": "word",
      "name": "Word",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "High Quality Ingredients"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Marquee",
      "blocks": [
        {
          "type": "word",
          "settings": {
            "text": "High Quality Ingredients"
          }
        },
        {
          "type": "word",
          "settings": {
            "text": "Independently Certified"
          }
        },
        {
          "type": "word",
          "settings": {
            "text": "Expert Driven"
          }
        },
        {
          "type": "word",
          "settings": {
            "text": "Shipped Internationally"
          }
        }
      ]
    }
  ]
}
{% endschema %}
